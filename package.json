{
  "name": "coffee-shop-tycoon-3d",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build",
    "media": "npm run build && node scripts/capture-media.mjs",
    "media:p20": "npm run build && node scripts/capture-p20.mjs",
    "media:p21": "npm run build && node scripts/capture-p21.mjs",
    "media:p22": "npm run build && node scripts/capture-p22.mjs",
    "media:loading": "npm run build && node scripts/capture-loading.mjs",
    "review:p22": "npm run build && node scripts/review-p22.mjs",
    "layout": "npm run build && node scripts/check-layout.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
