{
  "$description": "Coffee Shop Tycoon 3D - design tokens for the HTML/CSS overlay UI (HUD, panels, report). Format: Design Tokens Format Module (W3C Community Group). CSS variable mapping: color.coffee.700 -> --color-coffee-700, color.text.primary -> --text-primary, space.4 -> --space-4, etc. (see design/NOTES.md).",
  "color": {
    "$type": "color",
    "coffee": {
      "900": { "$value": { "colorSpace": "srgb", "components": [0.2314, 0.1412, 0.0941], "hex": "#3b2418" }, "$description": "Espresso - HUD surface, headings on light" },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.3608, 0.2275, 0.149], "hex": "#5c3a26" }, "$description": "Brand coffee - primary buttons, selected tab indicator" },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.5412, 0.3529, 0.2314], "hex": "#8a5a3b" }, "$description": "Data bars" },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.7882, 0.6353, 0.4941], "hex": "#c9a27e" }, "$description": "Muted text and borders on dark HUD" }
    },
    "cream": {
      "50": { "$value": { "colorSpace": "srgb", "components": [1, 0.9765, 0.9412], "hex": "#fff9f0" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9373, 0.8667], "hex": "#fbefdd" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.9529, 0.8745, 0.7608], "hex": "#f3dfc2" } }
    },
    "mint": {
      "800": { "$value": { "colorSpace": "srgb", "components": [0.0431, 0.3294, 0.2667], "hex": "#0b5444" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.4196, 0.3412], "hex": "#0f6b57" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.1843, 0.7216, 0.5961], "hex": "#2fb898" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.8667, 0.9647, 0.9333], "hex": "#ddf6ee" } }
    },
    "neutral": {
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.549, 0.498, 0.4588], "hex": "#8c7f75" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.4196, 0.3686, 0.3333], "hex": "#6b5e55" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.1294, 0.1098], "hex": "#2a211c" } }
    },
    "ok": {
      "700": { "$value": { "colorSpace": "srgb", "components": [0.1176, 0.4784, 0.2745], "hex": "#1e7a46" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.8902, 0.9608, 0.9176], "hex": "#e3f5ea" } }
    },
    "warning": {
      "700": { "$value": { "colorSpace": "srgb", "components": [0.4784, 0.2902, 0], "hex": "#7a4a00" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.949, 0.6471, 0.0863], "hex": "#f2a516" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.9451, 0.8392], "hex": "#fff1d6" } }
    },
    "danger": {
      "700": { "$value": { "colorSpace": "srgb", "components": [0.702, 0.149, 0.1176], "hex": "#b3261e" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.949, 0.4039, 0.3569], "hex": "#f2675b" }, "$description": "Danger on dark surfaces only (HUD, patience bar)" },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.9922, 0.9059, 0.898], "hex": "#fde7e5" } }
    },
    "star": {
      "500": { "$value": { "colorSpace": "srgb", "components": [0.7804, 0.4667, 0], "hex": "#c77700" } }
    },
    "focus": {
      "500": { "$value": { "colorSpace": "srgb", "components": [0.0431, 0.3412, 0.8157], "hex": "#0b57d0" }, "$description": "Focus ring on light surfaces" },
      "300": { "$value": { "colorSpace": "srgb", "components": [1, 0.8196, 0.4], "hex": "#ffd166" }, "$description": "Focus ring on dark HUD" }
    },
    "scene": {
      "$description": "Placeholder colours for the mockup illustration only; the 3D scene owns its own palette.",
      "sky": { "$value": { "colorSpace": "srgb", "components": [0.749, 0.902, 0.9608], "hex": "#bfe6f5" } },
      "ground": { "$value": { "colorSpace": "srgb", "components": [0.7255, 0.8706, 0.6039], "hex": "#b9de9a" } },
      "road": { "$value": { "colorSpace": "srgb", "components": [0.5569, 0.6039, 0.651], "hex": "#8e9aa6" } },
      "floor": { "$value": { "colorSpace": "srgb", "components": [0.9137, 0.8118, 0.6588], "hex": "#e9cfa8" } },
      "wall": { "$value": { "colorSpace": "srgb", "components": [0.9647, 0.8902, 0.7765], "hex": "#f6e3c6" } },
      "wall-shade": { "$value": { "colorSpace": "srgb", "components": [0.8863, 0.7725, 0.6157], "hex": "#e2c59d" } },
      "awning": { "$value": { "colorSpace": "srgb", "components": [0.8784, 0.4784, 0.3725], "hex": "#e07a5f" } },
      "wood": { "$value": { "colorSpace": "srgb", "components": [0.6275, 0.4392, 0.298], "hex": "#a0704c" } },
      "plant": { "$value": { "colorSpace": "srgb", "components": [0.2471, 0.651, 0.4196], "hex": "#3fa66b" } }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.700}" },
      "inverse": { "$value": "{color.cream.50}" },
      "inverse-muted": { "$value": "{color.coffee.300}" },
      "on-accent": { "$value": "{color.neutral.0}" },
      "on-bright": { "$value": "{color.coffee.900}" },
      "ok": { "$value": "{color.ok.700}" },
      "warning": { "$value": "{color.warning.700}" },
      "danger": { "$value": "{color.danger.700}" },
      "danger-inverse": { "$value": "{color.danger.400}" }
    },
    "surface": {
      "app": { "$value": "{color.cream.100}" },
      "panel": { "$value": { "colorSpace": "srgb", "components": [1, 0.9765, 0.9412], "alpha": 0.94, "hex": "#fff9f0" }, "$description": "Panel over the 3D scene: cream.50 at 94% + backdrop blur. Contrast is checked against panel-solid." },
      "panel-solid": { "$value": "{color.cream.50}" },
      "sunken": { "$value": "{color.cream.100}" },
      "hud": { "$value": { "colorSpace": "srgb", "components": [0.2314, 0.1412, 0.0941], "alpha": 0.92, "hex": "#3b2418" }, "$description": "HUD bar, customer tags. Contrast is checked against hud-solid." },
      "hud-solid": { "$value": "{color.coffee.900}" },
      "hud-raised": { "$value": "{color.coffee.700}" },
      "ok": { "$value": "{color.ok.100}" },
      "warning": { "$value": "{color.warning.100}" },
      "danger": { "$value": "{color.danger.100}" },
      "disabled": { "$value": "{color.cream.200}" },
      "selected": { "$value": "{color.mint.100}" },
      "scrim": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.1294, 0.1098], "alpha": 0.55, "hex": "#2a211c" }, "$description": "Only behind Daily Report and Pause" }
    },
    "border": {
      "subtle": { "$value": "{color.cream.200}", "$description": "Decorative dividers only" },
      "strong": { "$value": "{color.neutral.500}", "$description": "Inputs, secondary buttons, toggle off" },
      "inverse": { "$value": "{color.coffee.300}" }
    },
    "accent": {
      "primary": { "$value": "{color.coffee.700}" },
      "primary-hover": { "$value": "{color.coffee.900}" },
      "mint": { "$value": "{color.mint.700}" },
      "mint-hover": { "$value": "{color.mint.800}" },
      "mint-bright": { "$value": "{color.mint.500}" }
    },
    "data": {
      "bar": { "$value": "{color.coffee.500}" },
      "track": { "$value": "{color.cream.200}" }
    },
    "patience": {
      "high": { "$value": "{color.mint.500}" },
      "mid": { "$value": "{color.warning.500}" },
      "low": { "$value": "{color.danger.400}" },
      "track": { "$value": "{color.coffee.700}" }
    },
    "rating": {
      "star": { "$value": "{color.star.500}" },
      "empty": { "$value": "{color.neutral.500}" }
    },
    "focus-ring": {
      "default": { "$value": "{color.focus.500}" },
      "inverse": { "$value": "{color.focus.300}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 12, "unit": "px" }, "$description": "Meta labels only (HUD captions, patience %)" },
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 20, "unit": "px" } },
      "xl": { "$value": { "value": 24, "unit": "px" } },
      "2xl": { "$value": { "value": 32, "unit": "px" } },
      "3xl": { "$value": { "value": 40, "unit": "px" } }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "base": { "$value": 1.5 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.3xl}", "fontWeight": "{font.weight.bold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.2 } },
    "title": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.xl}", "fontWeight": "{font.weight.bold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.2 } },
    "heading": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.bold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.2 } },
    "body": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.5 } },
    "label": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.semibold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.5 } },
    "caption": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.2 } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "target": { "$value": { "value": 44, "unit": "px" }, "$description": "Minimum hit area for every control (Apple HIG 44pt; above WCAG 2.5.8 24px)" },
    "target-lg": { "$value": { "value": 56, "unit": "px" } },
    "panel": { "$value": { "value": 360, "unit": "px" }, "$description": "Side panel width at >= 1024px; max 42% of viewport so the shop centre stays visible" },
    "dialog": { "$value": { "value": 720, "unit": "px" } },
    "border-thin": { "$value": { "value": 1, "unit": "px" } },
    "border-thick": { "$value": { "value": 4, "unit": "px" } },
    "focus-width": { "$value": { "value": 3, "unit": "px" } },
    "focus-offset": { "$value": { "value": 2, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "color": { "colorSpace": "srgb", "components": [0.2314, 0.1412, 0.0941], "alpha": 0.18, "hex": "#3b2418" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "md": { "$value": { "color": { "colorSpace": "srgb", "components": [0.2314, 0.1412, 0.0941], "alpha": 0.2, "hex": "#3b2418" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "lg": { "$value": { "color": { "colorSpace": "srgb", "components": [0.2314, 0.1412, 0.0941], "alpha": 0.28, "hex": "#3b2418" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 32, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" }, "$description": "Hover, press, toggle thumb" },
    "base": { "$value": { "value": 200, "unit": "ms" }, "$description": "Tab switch, dropdown open, toast enter" },
    "slow": { "$value": { "value": 320, "unit": "ms" }, "$description": "Panel slide-in, report overlay fade" },
    "toast-visible": { "$value": { "value": 4000, "unit": "ms" }, "$description": "Info/success toasts auto-hide; warning/error stay until closed" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] }
  },
  "$extensions": {
    "claude-bridge": {
      "contrastPairs": [
        { "fg": "color.text.primary", "bg": "color.surface.panel-solid", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.sunken", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.selected", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.panel-solid", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.sunken", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.disabled", "use": "text" },
        { "fg": "color.text.inverse", "bg": "color.surface.hud-solid", "use": "text" },
        { "fg": "color.text.inverse", "bg": "color.surface.hud-raised", "use": "text" },
        { "fg": "color.text.inverse-muted", "bg": "color.surface.hud-solid", "use": "text" },
        { "fg": "color.text.danger-inverse", "bg": "color.surface.hud-solid", "use": "text" },
        { "fg": "color.accent.mint-bright", "bg": "color.surface.hud-solid", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.primary", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.primary-hover", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.mint", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.mint-hover", "use": "text" },
        { "fg": "color.text.on-bright", "bg": "color.accent.mint-bright", "use": "text" },
        { "fg": "color.text.ok", "bg": "color.surface.ok", "use": "text" },
        { "fg": "color.text.ok", "bg": "color.surface.panel-solid", "use": "text" },
        { "fg": "color.text.warning", "bg": "color.surface.warning", "use": "text" },
        { "fg": "color.text.warning", "bg": "color.surface.panel-solid", "use": "text" },
        { "fg": "color.text.danger", "bg": "color.surface.danger", "use": "text" },
        { "fg": "color.text.danger", "bg": "color.surface.panel-solid", "use": "text" },
        { "fg": "color.border.strong", "bg": "color.surface.panel-solid", "use": "ui" },
        { "fg": "color.border.strong", "bg": "color.surface.sunken", "use": "ui" },
        { "fg": "color.border.inverse", "bg": "color.surface.hud-solid", "use": "ui" },
        { "fg": "color.accent.mint", "bg": "color.surface.panel-solid", "use": "ui" },
        { "fg": "color.accent.primary", "bg": "color.surface.panel-solid", "use": "ui" },
        { "fg": "color.focus-ring.default", "bg": "color.surface.panel-solid", "use": "ui" },
        { "fg": "color.focus-ring.default", "bg": "color.surface.sunken", "use": "ui" },
        { "fg": "color.focus-ring.inverse", "bg": "color.surface.hud-solid", "use": "ui" },
        { "fg": "color.rating.star", "bg": "color.surface.panel-solid", "use": "ui" },
        { "fg": "color.rating.star", "bg": "color.surface.hud-solid", "use": "ui" },
        { "fg": "color.rating.empty", "bg": "color.surface.panel-solid", "use": "ui" },
        { "fg": "color.data.bar", "bg": "color.data.track", "use": "ui" },
        { "fg": "color.patience.high", "bg": "color.patience.track", "use": "ui" },
        { "fg": "color.patience.mid", "bg": "color.patience.track", "use": "ui" },
        { "fg": "color.patience.low", "bg": "color.patience.track", "use": "ui" }
      ]
    }
  }
}
