{
  "$description": "Coffee Shop Tycoon 3D - cozy cartoon tokens (T237) for the HTML/CSS overlay UI and the icon set. Format: Design Tokens Format Module (W3C Community Group). CSS variable mapping: color.<palette>.<step> -> --color-<palette>-<step>; color.text.* / surface.* / border.* / accent.* / data.* / patience.* / rating.* -> --text-* / --surface-* / --border-* / --accent-* / --data-* / --patience-* / --rating-*; color.icon.* -> --icon-*; color.focus-ring.default / .inverse -> --focus-ring / --focus-ring-inverse; font.*, space.*, radius.*, shadow.*, duration.*, easing.*, size.* -> --font-*, --space-*, --radius-*, --shadow-*, --duration-*, --easing-*, --size-*. Semantic names match src/ui/styles/tokens.css; see design/t237-cartoon/README.md.",
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.4314, 0.3098, 0.2353], "hex": "#6e4f3c" }, "$description": "Muted text, disabled dashed border" },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.2275, 0.1333, 0.0863], "hex": "#3a2216" }, "$description": "Ink: primary text, every outline, hard sticker shadow, icon strokes" }
    },
    "coffee": {
      "300": { "$value": { "colorSpace": "srgb", "components": [0.851, 0.6588, 0.4667], "hex": "#d9a877" }, "$description": "Latte: wood tops, drinks, icon fill" },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.6275, 0.4039, 0.2471], "hex": "#a0673f" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.4196, 0.2471, 0.1412], "hex": "#6b3f24" }, "$description": "Coffee liquid, chalkboard. Never put ink detail on top (low contrast)." },
      "900": { "$value": "{color.neutral.900}" }
    },
    "cream": {
      "50": { "$value": { "colorSpace": "srgb", "components": [1, 0.9804, 0.949], "hex": "#fffaf2" }, "$description": "Cards, panels, HUD pills" },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.9647, 0.9059, 0.8235], "hex": "#f6e7d2" }, "$description": "App background (current #f6e7d2 kept)" },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.9255, 0.8275, 0.698], "hex": "#ecd3b2" }, "$description": "Disabled fill, bar track, empty star" }
    },
    "honey": {
      "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.9412, 0.7804], "hex": "#fff0c7" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [1, 0.7569, 0.2706], "hex": "#ffc145" }, "$description": "Primary buttons, selected state, stars" },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.6471, 0.1412], "hex": "#f5a524" } }
    },
    "mint": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.851, 0.9647, 0.9176], "hex": "#d9f6ea" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.3725, 0.8275, 0.6588], "hex": "#5fd3a8" }, "$description": "Phase action (Mở cửa), high patience, happy face" },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.2392, 0.7412, 0.5608], "hex": "#3dbd8f" } }
    },
    "berry": {
      "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.8902, 0.8706], "hex": "#ffe3de" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [1, 0.5412, 0.4784], "hex": "#ff8a7a" }, "$description": "Danger buttons, low patience, angry face, awning" },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.9686, 0.4196, 0.3529], "hex": "#f76b5a" } }
    },
    "sky": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.8863, 0.9569, 0.9882], "hex": "#e2f4fc" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.5608, 0.8275, 0.9569], "hex": "#8fd3f4" }, "$description": "Info, machines, ice" },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.3725, 0.8157], "hex": "#1a5fd0" }, "$description": "Focus ring" }
    },
    "leaf": {
      "400": { "$value": { "colorSpace": "srgb", "components": [0.5608, 0.8118, 0.3725], "hex": "#8fcf5f" } }
    },
    "tangerine": {
      "400": { "$value": { "colorSpace": "srgb", "components": [1, 0.6275, 0.302], "hex": "#ffa04d" } }
    },
    "ok": {
      "700": { "$value": { "colorSpace": "srgb", "components": [0.0902, 0.4, 0.2275], "hex": "#17663a" } },
      "100": { "$value": "{color.mint.100}" }
    },
    "warning": {
      "700": { "$value": { "colorSpace": "srgb", "components": [0.4784, 0.2902, 0], "hex": "#7a4a00" } },
      "500": { "$value": "{color.honey.500}" },
      "100": { "$value": "{color.honey.100}" }
    },
    "danger": {
      "700": { "$value": { "colorSpace": "srgb", "components": [0.702, 0.149, 0.1176], "hex": "#b3261e" } },
      "400": { "$value": "{color.berry.400}" },
      "100": { "$value": "{color.berry.100}" }
    },
    "star": {
      "500": { "$value": "{color.honey.400}" }
    },
    "focus": {
      "500": { "$value": "{color.sky.700}" },
      "300": { "$value": { "colorSpace": "srgb", "components": [1, 0.8196, 0.4], "hex": "#ffd166" }, "$description": "Focus ring on ink surfaces only" }
    },
    "skin": {
      "1": { "$value": { "colorSpace": "srgb", "components": [1, 0.8627, 0.749], "hex": "#ffdcbf" } },
      "2": { "$value": { "colorSpace": "srgb", "components": [0.9412, 0.7255, 0.5529], "hex": "#f0b98d" } },
      "3": { "$value": { "colorSpace": "srgb", "components": [0.7882, 0.5412, 0.3686], "hex": "#c98a5e" } },
      "4": { "$value": { "colorSpace": "srgb", "components": [0.5529, 0.3529, 0.2314], "hex": "#8d5a3b" } }
    },
    "hair": {
      "1": { "$value": "{color.neutral.900}" },
      "2": { "$value": "{color.coffee.700}" },
      "3": { "$value": { "colorSpace": "srgb", "components": [0.851, 0.5098, 0.1686], "hex": "#d9822b" } },
      "4": { "$value": { "colorSpace": "srgb", "components": [0.949, 0.8118, 0.3882], "hex": "#f2cf63" } }
    },
    "scene": {
      "$description": "Mockup illustration and direction for the 3D palette; the 3D scene owns its own materials.",
      "sky": { "$value": { "colorSpace": "srgb", "components": [0.749, 0.902, 0.9608], "hex": "#bfe6f5" } },
      "sky-dawn": { "$value": { "colorSpace": "srgb", "components": [1, 0.8902, 0.7608], "hex": "#ffe3c2" }, "$description": "Preparation phase" },
      "sky-dusk": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.6902, 0.549], "hex": "#f5b08c" }, "$description": "Closing phase" },
      "ground": { "$value": { "colorSpace": "srgb", "components": [0.7255, 0.8706, 0.6039], "hex": "#b9de9a" } },
      "road": { "$value": { "colorSpace": "srgb", "components": [0.5569, 0.6039, 0.651], "hex": "#8e9aa6" } },
      "floor": { "$value": { "colorSpace": "srgb", "components": [0.9137, 0.8118, 0.6588], "hex": "#e9cfa8" } },
      "wall": { "$value": { "colorSpace": "srgb", "components": [0.9647, 0.8902, 0.7765], "hex": "#f6e3c6" } },
      "wall-shade": { "$value": { "colorSpace": "srgb", "components": [0.8863, 0.7725, 0.6157], "hex": "#e2c59d" } },
      "awning": { "$value": "{color.berry.400}" },
      "wood": { "$value": { "colorSpace": "srgb", "components": [0.6275, 0.4392, 0.298], "hex": "#a0704c" } },
      "plant": { "$value": "{color.leaf.400}" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.700}" },
      "inverse": { "$value": "{color.cream.50}" },
      "inverse-muted": { "$value": "{color.coffee.300}" },
      "on-accent": { "$value": "{color.neutral.900}", "$description": "Changed from white: every bright fill carries ink text" },
      "on-bright": { "$value": "{color.neutral.900}" },
      "ok": { "$value": "{color.ok.700}" },
      "warning": { "$value": "{color.warning.700}" },
      "danger": { "$value": "{color.danger.700}" }
    },
    "surface": {
      "app": { "$value": "{color.cream.100}" },
      "panel": { "$value": { "colorSpace": "srgb", "components": [1, 0.9804, 0.949], "alpha": 0.97, "hex": "#fffaf2" }, "$description": "Checked against panel-solid" },
      "panel-solid": { "$value": "{color.cream.50}" },
      "sunken": { "$value": "{color.cream.100}" },
      "hud": { "$value": { "colorSpace": "srgb", "components": [1, 0.9804, 0.949], "alpha": 0.97, "hex": "#fffaf2" }, "$description": "HUD is now light pills over the scene, not a dark bar" },
      "hud-solid": { "$value": "{color.cream.50}" },
      "hud-raised": { "$value": "{color.cream.100}" },
      "ink": { "$value": "{color.neutral.900}" },
      "ok": { "$value": "{color.ok.100}" },
      "warning": { "$value": "{color.warning.100}" },
      "danger": { "$value": "{color.danger.100}" },
      "info": { "$value": "{color.sky.100}" },
      "disabled": { "$value": "{color.cream.200}" },
      "selected": { "$value": "{color.honey.100}" },
      "scrim": { "$value": { "colorSpace": "srgb", "components": [0.2275, 0.1333, 0.0863], "alpha": 0.5, "hex": "#3a2216" }, "$description": "Only behind Daily Report and Pause" }
    },
    "border": {
      "subtle": { "$value": "{color.cream.200}", "$description": "Decorative dotted dividers only" },
      "strong": { "$value": "{color.neutral.900}" },
      "outline": { "$value": "{color.neutral.900}", "$description": "Cartoon outline on every card, button, pill, input" },
      "inverse": { "$value": "{color.coffee.300}" },
      "disabled": { "$value": "{color.neutral.700}", "$description": "Dashed" }
    },
    "accent": {
      "primary": { "$value": "{color.honey.400}" },
      "primary-hover": { "$value": "{color.honey.500}" },
      "mint": { "$value": "{color.mint.400}" },
      "mint-hover": { "$value": "{color.mint.500}" },
      "mint-bright": { "$value": "{color.mint.400}" },
      "danger": { "$value": "{color.berry.400}" },
      "danger-hover": { "$value": "{color.berry.500}" },
      "info": { "$value": "{color.sky.400}" }
    },
    "data": {
      "bar": { "$value": "{color.honey.400}", "$description": "Fill always has a 2px ink end edge; that edge carries the 3:1 boundary" },
      "track": { "$value": "{color.cream.200}" }
    },
    "patience": {
      "high": { "$value": "{color.mint.400}" },
      "mid": { "$value": "{color.honey.400}" },
      "low": { "$value": "{color.berry.400}" },
      "track": { "$value": "{color.neutral.900}" }
    },
    "rating": {
      "star": { "$value": "{color.honey.400}", "$description": "Always drawn with ink outline" },
      "empty": { "$value": "{color.cream.200}" }
    },
    "focus-ring": {
      "default": { "$value": "{color.focus.500}" },
      "inverse": { "$value": "{color.focus.300}" }
    },
    "icon": {
      "ink": { "$value": "{color.neutral.900}" },
      "fill-honey": { "$value": "{color.honey.400}" },
      "fill-mint": { "$value": "{color.mint.400}" },
      "fill-berry": { "$value": "{color.berry.400}" },
      "fill-sky": { "$value": "{color.sky.400}" },
      "fill-cream": { "$value": "{color.cream.50}" },
      "fill-latte": { "$value": "{color.coffee.300}" },
      "fill-coffee": { "$value": "{color.coffee.700}" },
      "fill-leaf": { "$value": "{color.leaf.400}" },
      "fill-orange": { "$value": "{color.tangerine.400}" },
      "fill-empty": { "$value": "{color.cream.200}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["ui-rounded", "SF Pro Rounded", "Nunito", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "$description": "System fonts only; Nunito is used only if installed. Bundling a rounded webfont is an open decision (page-weight task)." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "heavy": { "$value": 800, "$description": "Titles, buttons, HUD values" }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 12, "unit": "px" }, "$description": "Captions only, always bold" },
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 20, "unit": "px" } },
      "xl": { "$value": { "value": 24, "unit": "px" } },
      "2xl": { "$value": { "value": 32, "unit": "px" } },
      "3xl": { "$value": { "value": 40, "unit": "px" } },
      "4xl": { "$value": { "value": 48, "unit": "px" } }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25, "$description": "Raised from 1.2 so stacked Vietnamese marks (Ễ, Ộ) are not clipped" },
      "base": { "$value": 1.5 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.4xl}", "fontWeight": "{font.weight.heavy}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.25 } },
    "title": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.2xl}", "fontWeight": "{font.weight.heavy}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.25 } },
    "heading": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.xl}", "fontWeight": "{font.weight.heavy}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.25 } },
    "subheading": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.bold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.25 } },
    "body": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.5 } },
    "label": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.bold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.5 } },
    "caption": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.bold}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.5 } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "target": { "$value": { "value": 44, "unit": "px" }, "$description": "Minimum hit area (Apple HIG 44pt; above WCAG 2.5.8 24px)" },
    "target-lg": { "$value": { "value": 56, "unit": "px" } },
    "hud-pill": { "$value": { "value": 48, "unit": "px" } },
    "panel": { "$value": { "value": 380, "unit": "px" } },
    "dialog": { "$value": { "value": 760, "unit": "px" } },
    "outline": { "$value": { "value": 3, "unit": "px" }, "$description": "Thick cartoon outline" },
    "outline-sm": { "$value": { "value": 2, "unit": "px" }, "$description": "Badges, list rows, inner tiles" },
    "border-thin": { "$value": { "value": 2, "unit": "px" } },
    "border-thick": { "$value": { "value": 4, "unit": "px" } },
    "focus-width": { "$value": { "value": 3, "unit": "px" } },
    "focus-offset": { "$value": { "value": 3, "unit": "px" } },
    "icon-sm": { "$value": { "value": 16, "unit": "px" } },
    "icon-md": { "$value": { "value": 24, "unit": "px" }, "$description": "Design grid of every icon" },
    "icon-lg": { "$value": { "value": 32, "unit": "px" } },
    "icon-xl": { "$value": { "value": 48, "unit": "px" } },
    "icon-stroke": { "$value": { "value": 2, "unit": "px" }, "$description": "Stroke at 24px; scales with the icon" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 20, "unit": "px" } },
    "xl": { "$value": { "value": 28, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "color": "{color.neutral.900}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$description": "Hard sticker shadow; pressed state" },
    "md": { "$value": { "color": "{color.neutral.900}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$description": "Buttons and pills at rest" },
    "lg": { "$value": { "color": "{color.neutral.900}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 6, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$description": "Hover lift, dock" },
    "soft": { "$value": { "color": { "colorSpace": "srgb", "components": [0.2275, 0.1333, 0.0863], "alpha": 0.18, "hex": "#3a2216" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "card": { "$value": ["{shadow.lg}", "{shadow.soft}"], "$description": "Panels, report, menu card" }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": { "value": 80, "unit": "ms" }, "$description": "Press down" },
    "fast": { "$value": { "value": 120, "unit": "ms" }, "$description": "Hover lift, toggle" },
    "base": { "$value": { "value": 200, "unit": "ms" }, "$description": "Release bounce, panel close" },
    "slow": { "$value": { "value": 320, "unit": "ms" }, "$description": "Panel slide-in" },
    "pop": { "$value": { "value": 360, "unit": "ms" }, "$description": "Order bubble pop, report drop" },
    "float": { "$value": { "value": 800, "unit": "ms" }, "$description": "Coin fly from counter to HUD" },
    "count": { "$value": { "value": 400, "unit": "ms" }, "$description": "Money counter roll" },
    "idle-bob": { "$value": { "value": 1200, "unit": "ms" }, "$description": "Character idle loop" },
    "toast-visible": { "$value": { "value": 4000, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "bounce": { "$value": [0.34, 1.56, 0.64, 1], "$description": "Overshoot for pops, presses, slides" },
    "out": { "$value": [0.22, 1, 0.36, 1] }
  },
  "$extensions": {
    "claude-bridge": {
      "contrastPairs": [
        { "fg": "color.text.primary", "bg": "color.surface.app", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.panel-solid", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.sunken", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.selected", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.info", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.ok", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.warning", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.danger", "use": "text" },
        { "fg": "color.text.primary", "bg": "color.surface.hud-solid", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.primary", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.primary-hover", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.mint", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.mint-hover", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.danger", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.danger-hover", "use": "text" },
        { "fg": "color.text.on-accent", "bg": "color.accent.info", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.app", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.panel-solid", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.disabled", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.selected", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.ok", "use": "text" },
        { "fg": "color.text.muted", "bg": "color.surface.danger", "use": "text" },
        { "fg": "color.text.inverse", "bg": "color.surface.ink", "use": "text" },
        { "fg": "color.text.inverse-muted", "bg": "color.surface.ink", "use": "text" },
        { "fg": "color.text.ok", "bg": "color.surface.ok", "use": "text" },
        { "fg": "color.text.ok", "bg": "color.surface.panel-solid", "use": "text" },
